APP_NAME="Dahara Online API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.dahara-online.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Base de données MySQL ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dahara_online
DB_USERNAME=dahara_user
DB_PASSWORD=

# --- Auth API (Sanctum, tokens Bearer) ---
# Domaines autorisés à faire des requêtes "stateful" (cookies) - laisser vide si tokens Bearer purs
SANCTUM_STATEFUL_DOMAINS=

# Origines autorisées à appeler l'API (le domaine du frontend TanStack Start), séparées par des virgules
CORS_ALLOWED_ORIGINS=https://dahara-online.com

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@dahara-online.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Visioconférence (Jitsi auto-hébergé) ---
# URL de ton propre serveur Jitsi (ex: https://visio.dahara-online.com)
JITSI_DOMAIN=https://meet.jit.si

# --- API Coran externe (gratuite, sans clé) ---
QURAN_API_BASE=https://api.alquran.cloud/v1

# --- Paiements (Phase 3 - à remplir une fois les comptes marchands créés) ---
WAVE_API_KEY=
WAVE_API_BASE=https://api.wave.com/v1
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_API_BASE=

# URL du frontend TanStack Start, utilisée dans les liens des e-mails de notification
FRONTEND_URL=https://dahara-online.com

# --- Monitoring d'erreurs (optionnel) ---
# Laisse vide pour désactiver. Pour activer : composer require sentry/sentry-laravel
# puis renseigne le DSN de ton projet Sentry ici.
SENTRY_LARAVEL_DSN=
